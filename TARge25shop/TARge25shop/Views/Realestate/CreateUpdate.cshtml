@model TARge25shop.Models.Realestate.RealEstateCreateUpdateViewModel

<div class="card shadow-sm p-3">
    @if (Model.Id.HasValue)
    {
        <h1>Update</h1>
    }
    else
    {
        <h1>Create</h1>
    }

    <!-- PEAMINE VORM: Kõik sisestusväljad ja salvestamise nupud peavad olema SELLE sees -->
    <form method="post" enctype="multipart/form-data">
        <input asp-for="Id" type="hidden" />
        <input asp-for="CreatedAt" type="hidden" />
        <input asp-for="ModifiedAt" type="hidden" />

        <div class="form-group row" style="margin-bottom: 10px;">
            <label asp-for="Location" class="col-sm-2 col-form-label">Asukoht</label>
            <div class="col-sm-10">
                <input asp-for="Location" class="form-control" />
            </div>
        </div>

        <div class="form-group row" style="margin-bottom: 10px;">
            <label asp-for="Area" class="col-sm-2 col-form-label">Pindala (m²)</label>
            <div class="col-sm-10">
                <input asp-for="Area" class="form-control" type="number" step="0.01" />
            </div>
        </div>

        <div class="form-group row" style="margin-bottom: 10px;">
            <label asp-for="RoomNumber" class="col-sm-2 col-form-label">Tubade arv</label>
            <div class="col-sm-10">
                <input asp-for="RoomNumber" class="form-control" type="number" />
            </div>
        </div>

        <div class="form-group row" style="margin-bottom: 10px;">
            <label asp-for="BuildingType" class="col-sm-2 col-form-label">Hoonetüüp</label>
            <div class="col-sm-10">
                <input asp-for="BuildingType" class="form-control" />
            </div>
        </div>

        <div class="form-group row mb-3">
            <label asp-for="Files" class="control-label">Vali uued pildid </label>
            <input asp-for="Files" multiple type="file" class="form-control" />
        </div>

        <!-- TÕSTETUD SIIA SISSESSE: Create ja Update nupud töötavad ainult siin vormi sees -->
        <div class="mt-4 mb-3">
            @if (Model.Id.HasValue)
            {
                <button asp-action="Update" asp-controller="realestate" type="submit" class="btn btn-success">Update</button>
            }
            else
            {
                <button asp-action="create" asp-controller="realestate" type="submit" class="btn btn-success">Create</button>
            }
            <a asp-action="Index" asp-controller="realestate" class="btn btn-secondary">Back to List</a>
        </div>
    </form>

    <hr />

    <!-- OLEMASOLEVAD PILDID JA ERALDI VORM KUSTUTAMISEKS -->
    @if (Model.Image != null && Model.Image.Any())
    {
        <div class="mb-3">
            <h5>Praegused pildid:</h5>
            <div class="d-flex flex-wrap gap-3 justify-content-start">
                @foreach (var image in Model.Image)
                {
                    <div class="d-flex flex-column align-items-center" style=" padding: 10px; border-radius: 4px;">
                        <partial name="_Images" model="image" />
                    
                        <!-- KRIITILINE PARANDUS: Igale pildile oma väike POST-vorm koos õige peidetud ID-ga -->
                        <form asp-action="RemoveImage" asp-controller="realestate" method="post" class="mt-2">
                            <input type="hidden" name="ImageId" value="@image.ImageId" />
                            <button type="submit" class="btn btn-danger btn-sm">Remove Image</button>
                        </form>
                    </div>
                }
            </div>
        </div>
    }

</div>
