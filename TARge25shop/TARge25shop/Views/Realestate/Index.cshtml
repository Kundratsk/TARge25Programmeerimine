@model IEnumerable<TARge25shop.Models.Realestate.RealestateIndexViewModel>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Kinnisvara nimekiri</h2>
        <a asp-action="Create" class="btn btn-success">Lisa uus kinnisvara</a>
    </div>

    <table class="table table-striped table-bordered">
        <thead class="table-info">
            <tr>
                <th>Asukoht</th>
                <th>Pindala (m²)</th>
                <th>Tubade arv</th>
                <th>Hoonetüüp</th>
                <th>Loodud</th>
                <th>Uuendatud</th>
                <th class="text-center">Tegevused</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Location</td>
                    <td>@item.Area</td>
                    <td>@item.RoomNumber</td>
                    <td>@item.BuildingType</td>
                    <td>@item.CreatedAt</td>
                    <td>@item.ModifiedAt</td>
                    <td class="text-center">
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm">Vaata detaile</a>
                        <a asp-action="Update" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm">Muuda</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Kustuta</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
