@model TARge25shop.Models.Realestate.RealestateDetailsViewModel

<div class="container mt-4">
    <div class="card shadow-sm">
        <div >
            <h2 class="mb-0">Kinnisvara üksikasjad</h2>
        </div>
        <div class="card-body">
            <dl class="row font-size-lg">
                <dt class="col-sm-3 text-muted">Asukoht:</dt>
                <dd class="col-sm-9 fw-bold">@Model.Location</dd>

                <dt class="col-sm-3 text-muted">Pindala:</dt>
                <dd class="col-sm-9">@Model.Area m²</dd>

                <dt class="col-sm-3 text-muted">Tubade arv:</dt>
                <dd class="col-sm-9">@Model.RoomNumber</dd>

                <dt class="col-sm-3 text-muted">Hoonetüüp:</dt>
                <dd class="col-sm-9">@Model.BuildingType</dd>
                
                <dt class="col-sm-3 text-muted">Loodud:</dt>
                <!-- Kasutame .Value, kuna loomise aeg on alati olemas -->
                <dd class="col-sm-9 text-secondary">@Model.CreatedAt.Value.ToString("dd.MM.yyyy HH:mm")</dd>

                <dt class="col-sm-3 text-muted">Uuendatud:</dt>
                <!-- Kui väärtus on olemas, võtame .Value ja vormindame, muidu kuvame kriipsu -->
                <dd class="col-sm-9 text-secondary">@(Model.ModifiedAt != null ? Model.ModifiedAt.Value.ToString("dd.MM.yyyy HH:mm") : "-")</dd>

            </dl>


            <div class="mt-4">
                <h4 class="mb-3 text-secondary">Kinnisvara pildid</h4>
                
                @if (Model.Images != null && Model.Images.Any())
                {
                    <div class="d-flex flex-wrap gap-3 p-3 bg-light rounded border">
                        @foreach (var images in Model.Images)
                        {
                            <partial name="_Images" model="images" />
                        }
                    </div>
                }
                else
                {
                    <div class="alert alert-info py-2" role="alert">
                        Sellel kinnisvaral pole andmebaasis ühtegi pilti.
                    </div>
                }
            </div>
        </div>
        <div class="card-footer bg-transparent d-flex gap-2">
            <a asp-action="Update" asp-route-id="@Model.Id" class="btn btn-warning px-4">Muuda andmeid</a>
            <a asp-action="Index" class="btn btn-outline-secondary px-4">Tagasi nimekirja</a>
        </div>
    </div>
</div>
