@model TARge25shop.Models.Spaceship.SpaceshipUpdateViewModel

@{
    ViewData["Title"] = "Uuenda kosmoselaeva";
}

<div class="container mt-4">
    <h1 class="mb-4">Uuenda kosmoselaeva</h1>

    <div class="row">
        <div class="col-md-6">
            <form asp-action="Update" method="post" class="card p-4 shadow-sm bg-light">
                <!-- See rida aitab ekraanile kuvada veateateid, kui midagi on valesti -->
                <div asp-validation-summary="All" class="text-danger"></div>

                <!-- Peidetud ID on kohustuslik, muidu EF Core ei tea, mida uuendada! -->
                <input type="hidden" asp-for="Id" />

                <div class="form-group mb-3">
                    <label asp-for="Name" class="form-label fw-bold">Laeva nimi</label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="ShipType" class="form-label fw-bold">Tüüp</label>
                    <input asp-for="ShipType" class="form-control" />
                    <span asp-validation-for="ShipType" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Crew" class="form-label fw-bold">Meeskonna suurus</label>
                    <input asp-for="Crew" class="form-control" type="number" />
                    <span asp-validation-for="Crew" class="text-danger"></span>
                </div>

                <div class="form-group mb-4">
                    <label asp-for="EnginePower" class="form-label fw-bold">Mootori võimsus</label>
                    <input asp-for="EnginePower" class="form-control" type="number" />
                    <span asp-validation-for="EnginePower" class="text-danger"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Salvesta muudatused</button>
                    <a asp-action="Index" class="btn btn-secondary">Tagasi nimekirja</a>
                </div>
            </form>
        </div>
    </div>
</div>
