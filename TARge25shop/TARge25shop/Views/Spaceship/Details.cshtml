@model TARge25shop.Models.Spaceship.SpaceshipDetailsViewModel


@{
    ViewData["Title"] = "Kosmoselaeva andmed";
}

<style>
    /* ---------- 3D laeva stseen ---------- */
    .ship-stage {
        position: relative;
        height: clamp(340px, 56vh, 520px);
        margin-bottom: 1.25rem;
        border-radius: 12px;
        overflow: hidden;
        cursor: grab;
        touch-action: pan-y;          /* vertikaalne kerimine töötab, horisontaalne pööramine kuulub laevale */
        user-select: none;
        -webkit-user-select: none;
        background: radial-gradient(ellipse at 50% 100%, #3a1a3d 0%, #1b1026 45%, #0b0618 100%);
        box-shadow: inset 0 0 0 2px #f5c26b;
    }
    .ship-stage.dragging { cursor: grabbing; }
    .ship-stage canvas { display: block; width: 100%; height: 100%; }
    .ship-hint {
        position: absolute; left: 0; right: 0; bottom: 8px; text-align: center; pointer-events: none;
        color: rgba(245,233,208,.7); font-size: .8rem; letter-spacing: .08em;
    }
    .ship-fallback { position: absolute; inset: 0; display: none; align-items: center; justify-content: center; color: #f5e9d0; text-align: center; padding: 1rem; }

    /* ---------- Andmesildid laeva peal ---------- */
    .hs { position: absolute; left: 0; top: 0; pointer-events: none; will-change: transform; }
    .hs-in { display: flex; align-items: center; gap: 0; transform: translate(0, -50%); }
    .hs.left .hs-in { flex-direction: row-reverse; transform: translate(-100%, -50%); }
    .hs-dot {
        width: 12px; height: 12px; border-radius: 50%; flex-shrink: 0;
        background: #f5c26b; box-shadow: 0 0 0 0 rgba(245,194,107,.7);
        animation: hs-pulse 1.8s infinite;
    }
    .hs-line { width: 34px; height: 2px; background: #f5c26b; flex-shrink: 0; }
    .hs-card {
        opacity: 0;
        background: rgba(27,16,38,.88); border: 1px solid #f5c26b; border-radius: 8px;
        padding: .3rem .7rem; color: #f5e9d0; white-space: nowrap; line-height: 1.2;
    }
    .hs-card small { display: block; color: #f5c26b; letter-spacing: .12em; font-size: .62rem; text-transform: uppercase; }
    .hs-card b { font-size: 1.05rem; }
    @@keyframes hs-pulse {
        0% { box-shadow: 0 0 0 0 rgba(245,194,107,.7); }
        70% { box-shadow: 0 0 0 12px rgba(245,194,107,0); }
        100% { box-shadow: 0 0 0 0 rgba(245,194,107,0); }
    }
    @@media (max-width: 575.98px) {
        .hs-line { width: 16px; }
        .hs-card b { font-size: .9rem; }
    }

    .kg-btn {
        display: inline-flex;
        justify-content: center;
        align-items: center;
        gap: 8px;
        padding: 11px 17px;
        border-radius: 10px;
        font-size: 13px;
        font-weight: 650;
        text-decoration: none;
        border: 1px solid transparent;
        transition: .2s ease;
    }

    .kg-btn-edit {
        background: #6257e8;
        color: white;
    }
</style>

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-black text-bg-primary">
            <h2 class="mb-0">🚀 Kosmoselaeva üksikasjad: @Model.Name</h2>
        </div>
        <div class="card-body">

            <!-- 3D mudel: andmed tulevad data-atribuutidega JavaScripti -->
            <div class="ship-stage" id="shipStage"
                 data-name="@Model.Name"
                 data-power="@Convert.ToDouble(Model.EnginePower).ToString(System.Globalization.CultureInfo.InvariantCulture)"
                 data-power-text="@Model.EnginePower"
                 data-crew="@Convert.ToInt32(Model.Crew)">

                <div class="ship-fallback" id="shipFallback">3D vaade ei käivitunud (brauser ei toeta WebGL-i või Three.js ei laadinud).</div>

                <div class="hs" id="hsName" data-anchor="0,0.72,-0.4">
                    <div class="hs-in"><span class="hs-dot"></span><span class="hs-line"></span>
                        <div class="hs-card"><small>@Model.ShipType</small><b>@Model.Name</b></div></div>
                </div>
                <div class="hs left" id="hsCrew" data-anchor="0,0.85,1.35">
                    <div class="hs-in"><span class="hs-dot"></span><span class="hs-line"></span>
                        <div class="hs-card"><small>Meeskond</small><b><span id="crewVal">@Model.Crew</span> liiget</b></div></div>
                </div>
                <div class="hs" id="hsPower" data-anchor="0.9,0,-3.1">
                    <div class="hs-in"><span class="hs-dot"></span><span class="hs-line"></span>
                        <div class="hs-card"><small>Mootori võimsus</small><b><span id="powerVal">@Model.EnginePower</span> kW</b></div></div>
                </div>

                <div class="ship-hint">Lohista laeva pööramiseks</div>
            </div>

            <dl class="row">
                <dt class="col-sm-3 font-weight-bold">ID:</dt>
                <dd class="col-sm-9 text-muted">@Model.Id</dd>

                <dt class="col-sm-3 font-weight-bold">Nimi:</dt>
                <dd class="col-sm-9">@Model.Name</dd>

                <dt class="col-sm-3 font-weight-bold">Tüüp:</dt>
                <dd class="col-sm-9">@Model.ShipType</dd>

                <dt class="col-sm-3 font-weight-bold">Mootori võimsus:</dt>
                <dd class="col-sm-9">@Model.EnginePower kW</dd>

                <dt class="col-sm-3 font-weight-bold">Meeskond:</dt>
                <dd class="col-sm-9">@Model.Crew liiget</dd>

                <dt class="col-sm-3 font-weight-bold">Tehtud:</dt>
                <dd class="col-sm-9">@Model.CreatedAt</dd>

                <dt class="col-sm-3 font-weight-bold">Uuendatud:</dt>
                <dd class="col-sm-9">@Model.UpdatedAt</dd>
            </dl>
            @foreach (var images in Model.Image)
            {
                <partial name="_Images" model="images" />
            }
        </div>
        <div class="card-footer bg-light d-flex gap-2">
            <a asp-action="Update" asp-route-id="@Model.Id" class="kg-btn kg-btn-edit">Muuda andmeid</a>
            <a asp-action="Index" class="kg-btn kg-btn-back">Tagasi nimekirja</a>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Three.js r128 (klassikaline skript; _Layout'i tühi importmap ei sega) ja anime.js 3 -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/animejs/3.2.1/anime.min.js"></script>
    <script>
    (function () {
        'use strict';

        var stage = document.getElementById('shipStage');
        var fallback = document.getElementById('shipFallback');
        if (!stage || !window.THREE) { if (fallback) fallback.style.display = 'flex'; return; }

        /* ================= KOHANDATAV ================= */
        var MAX_POWER   = 1000;   // selle võimsusega (kW) on leek maksimaalse pikkusega
        var MAX_WINDOWS = 36;     // maksimaalselt nii palju meeskonna aknaid kerel
        var AUTO_SPIN   = 0.0035; // iseenesliku pöörlemise kiirus

        var POWER = parseFloat(stage.dataset.power) || 0;
        var CREW  = parseInt(stage.dataset.crew, 10) || 0;
        var NAME  = stage.dataset.name || '';
        var power01 = Math.max(0.12, Math.min(1, POWER / MAX_POWER));

        /* ---------- Renderdaja, stseen, kaamera ---------- */
        var renderer;
        try {
            renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
        } catch (e) { fallback.style.display = 'flex'; return; }
        renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
        stage.insertBefore(renderer.domElement, stage.firstChild);

        var scene = new THREE.Scene();
        var camera = new THREE.PerspectiveCamera(40, 1, 0.1, 200);
        camera.position.set(0, 2.4, 11.5);
        camera.lookAt(0, 0, 0);

        /* ---------- Valgus ---------- */
        scene.add(new THREE.AmbientLight(0x8a7aa8, 0.7));
        var key = new THREE.DirectionalLight(0xfff0d0, 1.1); key.position.set(5, 8, 6); scene.add(key);
        var rim = new THREE.DirectionalLight(0xff7a3c, 0.8); rim.position.set(-6, 2, -6); scene.add(rim);

        /* ---------- Tähed ---------- */
        var sp = new Float32Array(500 * 3);
        for (var i = 0; i < 500; i++) {
            var r = 40 + Math.random() * 40, th = Math.random() * 6.283, ph = Math.acos(2 * Math.random() - 1);
            sp[i * 3] = r * Math.sin(ph) * Math.cos(th); sp[i * 3 + 1] = r * Math.sin(ph) * Math.sin(th); sp[i * 3 + 2] = r * Math.cos(ph);
        }
        var sg = new THREE.BufferGeometry(); sg.setAttribute('position', new THREE.BufferAttribute(sp, 3));
        scene.add(new THREE.Points(sg, new THREE.PointsMaterial({ color: 0xffffff, size: 0.18 })));

        /* ---------- Laev (nina on +Z suunas) ---------- */
        var ship = new THREE.Group();
        scene.add(ship);

        // värv sõltub laeva nimest
        var hash = 0; for (var c = 0; c < NAME.length; c++) { hash = (hash * 31 + NAME.charCodeAt(c)) % 360; }
        var hullCol = new THREE.Color().setHSL(hash / 360, 0.35, 0.58);
        var hullMat = new THREE.MeshStandardMaterial({ color: hullCol, metalness: 0.6, roughness: 0.35, side: THREE.DoubleSide });
        var darkMat = new THREE.MeshStandardMaterial({ color: 0x2a2433, metalness: 0.7, roughness: 0.4 });

        // kere: ees kitsam (radiusTop), taga laiem (radiusBottom); rotateX(PI/2) -> ülemine ots läheb +Z poole
        var body = new THREE.Mesh(new THREE.CylinderGeometry(0.6, 0.8, 4, 28).rotateX(Math.PI / 2), hullMat);
        ship.add(body);
        var nose = new THREE.Mesh(new THREE.ConeGeometry(0.6, 1.7, 28).rotateX(Math.PI / 2), hullMat);
        nose.position.z = 2.85; ship.add(nose);

        // kokpit
        var cockpit = new THREE.Mesh(new THREE.SphereGeometry(0.42, 20, 16),
            new THREE.MeshStandardMaterial({ color: 0x66ccff, emissive: 0x114466, metalness: 0.9, roughness: 0.1 }));
        cockpit.scale.set(0.9, 0.75, 1.5); cockpit.position.set(0, 0.52, 1.3); ship.add(cockpit);

        // tiivad (ekstrudeeritud nurgeline kuju), parem pool on peegel
        var ws = new THREE.Shape();
        ws.moveTo(0.5, 0); ws.lineTo(3.3, 1.8); ws.lineTo(3.3, 2.5); ws.lineTo(0.5, 1.8); ws.closePath();
        var wingGeo = new THREE.ExtrudeGeometry(ws, { depth: 0.12, bevelEnabled: false }).rotateX(-Math.PI / 2);
        var wingR = new THREE.Mesh(wingGeo, hullMat); wingR.position.set(0, -0.08, 0.5);
        var wingL = wingR.clone(); wingL.scale.x = -1;
        ship.add(wingR, wingL);

        // saba
        var fin = new THREE.Mesh(new THREE.BoxGeometry(0.08, 1.0, 1.1), hullMat);
        fin.position.set(0, 0.85, -1.7); fin.rotation.x = -0.35; ship.add(fin);

        // mootorid + leegid
        var flames = [];
        var flameGeo = new THREE.ConeGeometry(0.26, 1, 16); flameGeo.translate(0, 0.5, 0); flameGeo.rotateX(-Math.PI / 2); // alus z=0, tipp -Z suunas
        [-0.95, 0.95].forEach(function (x) {
            var eng = new THREE.Mesh(new THREE.CylinderGeometry(0.3, 0.38, 1.3, 20).rotateX(Math.PI / 2), darkMat);
            eng.position.set(x, 0, -2.3); ship.add(eng);
            var flame = new THREE.Mesh(flameGeo, new THREE.MeshBasicMaterial({ color: 0xff9a3c, transparent: true, opacity: 0.85, blending: THREE.AdditiveBlending, depthWrite: false }));
            flame.position.set(x, 0, -2.95); ship.add(flame); flames.push(flame);
            var pl = new THREE.PointLight(0xff8a3c, 0.4 + power01 * 1.6, 7); pl.position.set(x, 0, -3.3); ship.add(pl);
        });

        // meeskonna aknad: iga põlev aken = üks meeskonnaliige (kuni MAX_WINDOWS)
        var winMat = new THREE.MeshBasicMaterial({ color: 0xffe08a });
        var total = Math.min(CREW, MAX_WINDOWS), perSide = Math.ceil(total / 2), rows = 3, cols = Math.max(1, Math.ceil(perSide / rows)), placed = 0;
        [-1, 1].forEach(function (side) {
            for (var k = 0; k < perSide && placed < total; k++, placed++) {
                var col = Math.floor(k / rows), row = k % rows;
                var z = 1.5 - col * (3.0 / Math.max(cols - 1, 1));
                var rad = 0.7 - 0.05 * z;                       // kere raadius selles kohas
                var ang = (row * 22 + 8) * Math.PI / 180;
                var w = new THREE.Mesh(new THREE.SphereGeometry(0.055, 10, 8), winMat);
                w.position.set(side * rad * Math.cos(ang) * 1.02, rad * Math.sin(ang), z);
                ship.add(w);
            }
        });

        /* ---------- Sildid (3D punkt -> ekraani koordinaadid) ---------- */
        var spots = Array.prototype.map.call(stage.querySelectorAll('.hs'), function (el) {
            var a = el.dataset.anchor.split(',').map(parseFloat);
            return { el: el, v: new THREE.Vector3(a[0], a[1], a[2]) };
        });
        var W = 1, H = 1;
        function updateSpots() {
            spots.forEach(function (s) {
                var p = ship.localToWorld(s.v.clone()).project(camera);
                s.el.style.transform = 'translate(' + ((p.x * 0.5 + 0.5) * W).toFixed(1) + 'px,' + ((-p.y * 0.5 + 0.5) * H).toFixed(1) + 'px)';
            });
        }

        /* ---------- Suurus ---------- */
        function resize() {
            W = stage.clientWidth; H = stage.clientHeight;
            renderer.setSize(W, H, false);
            camera.aspect = W / H;
            camera.position.z = W < 520 ? 14.5 : 11.5;   // kitsal ekraanil kaamera kaugemale
            camera.updateProjectionMatrix();
        }
        resize();
        if (window.ResizeObserver) { new ResizeObserver(resize).observe(stage); } else { window.addEventListener('resize', resize); }

        /* ---------- Pööramine lohistamisega ---------- */
        var rotY = 0.7, rotX = 0.18, dragging = false, lx = 0, ly = 0;
        stage.addEventListener('pointerdown', function (e) { dragging = true; lx = e.clientX; ly = e.clientY; stage.classList.add('dragging'); stage.setPointerCapture(e.pointerId); });
        stage.addEventListener('pointermove', function (e) {
            if (!dragging) return;
            rotY += (e.clientX - lx) * 0.01;
            rotX = Math.max(-0.5, Math.min(0.6, rotX + (e.clientY - ly) * 0.006));
            lx = e.clientX; ly = e.clientY;
        });
        function endDrag() { dragging = false; stage.classList.remove('dragging'); }
        stage.addEventListener('pointerup', endDrag);
        stage.addEventListener('pointercancel', endDrag);

        /* ---------- Render ---------- */
        function frame(t) {
            if (!dragging) rotY += AUTO_SPIN;
            ship.rotation.y = rotY;
            ship.rotation.x = rotX;
            ship.position.y = Math.sin(t / 900) * 0.08;          // õrn hõljumine

            // leegi pikkus sõltub võimsusest, väike väreluse efekt
            var len = (0.8 + power01 * 3.2) * (0.9 + Math.random() * 0.2);
            flames.forEach(function (f) { f.scale.set(0.9 + Math.random() * 0.2, 0.9 + Math.random() * 0.2, len); });

            renderer.render(scene, camera);
            updateSpots();
            requestAnimationFrame(frame);
        }
        requestAnimationFrame(frame);

        /* ---------- anime.js: sissetulek, sildid, numbrite loendus ---------- */
        if (window.anime) {
            anime({ targets: ship.position, z: [-22, 0], duration: 2200, easing: 'easeOutExpo' });
            anime({ targets: '.hs-card', opacity: [0, 1], scale: [0.6, 1], duration: 600, easing: 'easeOutBack',
                    delay: anime.stagger(250, { start: 1500 }) });

            var pEl = document.getElementById('powerVal'), cEl = document.getElementById('crewVal');
            var pText = stage.dataset.powerText, cText = cEl.textContent;
            var counter = { p: 0, c: 0 };
            anime({ targets: counter, p: POWER, c: CREW, round: 1, duration: 1800, delay: 1500, easing: 'easeOutExpo',
                    update: function () { pEl.textContent = counter.p; cEl.textContent = counter.c; },
                    complete: function () { pEl.textContent = pText; cEl.textContent = cText; } });
        } else {
            Array.prototype.forEach.call(document.querySelectorAll('.hs-card'), function (c) { c.style.opacity = 1; });
        }
    })();
    </script>
}