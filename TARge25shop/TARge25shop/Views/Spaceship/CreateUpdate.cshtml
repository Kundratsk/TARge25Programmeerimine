@model TARge25shop.Models.Spaceship.SpaceshipCreateUpdateViewModel

<style>


    .kg-btn {
        display: inline-flex;
        justify-content: center;
        align-items: center;
        gap: 8px;
        padding: 11px 17px;
        border-radius: 10px;
        font-size: 13px;
        font-weight: 650;
        text-decoration: none;
        border: 1px solid transparent;
        transition: .2s ease;
    }

    .kg-btn-edit {
        background: #6257e8;
        color: white;
    }

</style>


@if (Model.Id.HasValue) {
    <h1>
        Update
    </h1>
}
else
{
    <h1>
        Create
    </h1>
}



<form method="post" enctype="multipart/form-data">
    <input asp-for="Id" type="hidden"/>
    <input asp-for="CreatedAt" type="hidden"/>
    <input asp-for="UpdatedAt" type="hidden"/>

    <div class="form-group row" style="margin-bottom: 10px;">
        <label asp-for="Name" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="Name" class="form-control"/>
        </div>
    </div>

    <div class="form-group row" style="margin-bottom: 10px;">
        <label asp-for="ShipType" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="ShipType" class="form-control" />
        </div>
    </div>

    <div class="form-group row" style="margin-bottom: 10px;">
        <label asp-for="Crew" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="Crew" class="form-control" />
        </div>
    </div>

    <div class="form-group row" style="margin-bottom: 10px;">
        <label asp-for="EnginePower" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="EnginePower" class="form-control" />
        </div>
    </div>

    <div class="form-group row" style="margin-bottom: 10px;">
        <label asp-for="Files" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <div class="custom-file">
                <input  type="file" asp-for="Files" multiple class="form-control" />
            </div>
        </div>
    </div>
    <div>
    @foreach (var images in Model.Images)
        {
            <partial name="_Images" model="images"/>
        //siia oleks Delete nuppu vaja
        <input asp-action="removeImage" asp-controller="spaceship" asp-route-imageId="@images.ImageId" type="submit" class="btn btn-danger" value="Remove Image"/>
        }
        <hr />
        <br />
    </div>
    @if (Model.Id.HasValue)
        {
        <input asp-action="Update" asp-controller="spaceship" type="submit" class="kg-btn kg-btn-edit" value="Update" />
        }
        else
        {
        <input asp-action="create" asp-controller="spaceship" type="submit" class="kg-btn kg-btn-edit" value="Create" />
        }

    <a asp-action="Index" asp-controller="spaceship" class="kg-btn kg-btn-back">Back to List</a>
</form>