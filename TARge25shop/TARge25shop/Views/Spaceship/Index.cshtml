@model TARge25shop.Models.Spaceship.SpaceshipCreateViewModel


<div>
    <a asp-action="create" asp-controller="spaceship" type="submit" class="btn btn-primary">Create</a>
</div>


<div class="h1">
    Spaceships
</div>
<form method="get">
<table class="table table-hover">
    <thead>
        <trow>
                <th scope="col">Nr</th>
                <th scope="col">Name</th>
                <th scope="col">Type</th>
                <th scope="col">Built Date</th>
                <th scope="col">Crew</th>
        </trow>
    </thead>
</table>

</form>