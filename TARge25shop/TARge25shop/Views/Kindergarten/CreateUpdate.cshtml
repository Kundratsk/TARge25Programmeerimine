@model TARge25shop.Models.Kindergarten.KindergartenCreateUpdateViewModel

@{
    ViewData["Title"] = Model.Id == null ? "Create Kindergarten" : "Edit Kindergarten";
}

<h1>@ViewData["Title"]</h1>

<form asp-action="@(Model.Id == null ? "Create" : "Update")"
      method="post"
      enctype="multipart/form-data">

    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label asp-for="GroupName" class="form-label">Group Name</label>
        <input asp-for="GroupName" class="form-control" />
        <span asp-validation-for="GroupName" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="KindergartenName" class="form-label">Kindergarten Name</label>
        <input asp-for="KindergartenName" class="form-control" />
        <span asp-validation-for="KindergartenName" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ChildrenCount" class="form-label">Children Count</label>
        <input asp-for="ChildrenCount" type="number" class="form-control" />
        <span asp-validation-for="ChildrenCount" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="TeacherName" class="form-label">Teacher Name</label>
        <input asp-for="TeacherName" class="form-control" />
        <span asp-validation-for="TeacherName" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label for="Files" class="form-label">Kindergarten images</label>
        <input type="file"
               id="Files"
               name="Files"
               class="form-control"
               accept="image/*"
               multiple />
        <div class="form-text">You can select multiple images.</div>
    </div>

    <button type="submit" class="btn btn-primary">Save</button>

    <a asp-action="Index" class="btn btn-secondary">Back</a>
</form>

@if (Model.Id != null && Model.Image.Count > 0)
{
    <hr />
    <h4>Existing images</h4>

    <div class="d-flex flex-wrap gap-3">
        @foreach (var img in Model.Image)
        {
            <form asp-action="RemoveImage" method="post" class="text-center">
                <input type="hidden" name="ImageId" value="@img.ImageId" />
                <input type="hidden" name="KindergartenId" value="@img.KindergartenId" />

                <img src="@img.ImageData"
                     alt="@img.ImageTitle"
                     style="height:120px; width:auto; display:block;"
                     class="img-thumbnail mb-2" />

                <button type="submit" class="btn btn-danger btn-sm">Delete image</button>
            </form>
        }
    </div>
}

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}