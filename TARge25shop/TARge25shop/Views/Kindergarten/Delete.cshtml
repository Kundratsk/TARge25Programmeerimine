@model TARge25shop.Models.Kindergarten.KindergartenDeleteViewModel

@{
    ViewData["Title"] = "Delete Kindergarten";
}

<h1>Delete Kindergarten</h1>

<h3>Are you sure you want to delete this?</h3>

<div>
    <dl class="row">

        <dt class="col-sm-3">
            Group Name
        </dt>
        <dd class="col-sm-9">
            @Model.GroupName
        </dd>

        <dt class="col-sm-3">
            Kindergarten Name
        </dt>
        <dd class="col-sm-9">
            @Model.KindergartenName
        </dd>

        <dt class="col-sm-3">
            Children Count
        </dt>
        <dd class="col-sm-9">
            @Model.ChildrenCount
        </dd>

        <dt class="col-sm-3">
            Teacher Name
        </dt>
        <dd class="col-sm-9">
            @Model.TeacherName
        </dd>

    </dl>

    <form asp-action="DeleteConfirmed" method="post">

        <input type="hidden" asp-for="Id" />

        <button type="submit"
                class="btn btn-danger">
            Delete
        </button>

        <a asp-action="Index"
           class="btn btn-secondary">
            Cancel
        </a>

    </form>
</div>