@model TARge25shop.Models.Kindergarten.KindergartenDeleteViewModel

@{
    ViewData["Title"] = "Delete Kindergarten";
}

<h1>Delete Kindergarten</h1>

<h3>Are you sure you want to delete this?</h3>

<div>
    <dl class="row">

        <dt class="col-sm-3">
            Group Name
        </dt>
        <dd class="col-sm-9">
            @Model.GroupName
        </dd>

        <dt class="col-sm-3">
            Kindergarten Name
        </dt>
        <dd class="col-sm-9">
            @Model.KindergartenName
        </dd>

        <dt class="col-sm-3">
            Children Count
        </dt>
        <dd class="col-sm-9">
            @Model.ChildrenCount
        </dd>

        <dt class="col-sm-3">
            Teacher Name
        </dt>
        <dd class="col-sm-9">
            @Model.TeacherName
        </dd>

        <dt class="col-sm-3">
            Images
        </dt>
        <dd class="col-sm-9">
            @if (Model.Image.Count == 0)
            {
                <span class="text-muted">No images</span>
            }
            else
            {
                <div class="d-flex flex-wrap gap-3">
                    @foreach (var img in Model.Image)
                    {
                        <img src="@img.ImageData"
                             alt="@img.ImageTitle"
                             style="height:120px; width:auto;"
                             class="img-thumbnail" />
                    }
                </div>
            }
        </dd>

    </dl>

    <form asp-action="DeleteConfirmed" method="post">

        <input type="hidden" asp-for="Id" />

        <button type="submit"
                class="btn btn-danger">
            Delete
        </button>

        <a asp-action="Index"
           class="btn btn-secondary">
            Cancel
        </a>

    </form>
</div>