@model IEnumerable<TARge25shop.Models.Kindergarten.KindergartenIndexViewModel>

@{
    ViewData["Title"] = "Kindergarten";

    var groups = Model?.ToList()
        ?? new List<TARge25shop.Models.Kindergarten.KindergartenIndexViewModel>();

    var totalGroups = groups.Count;
    var totalChildren = groups.Sum(x => x.ChildrenCount);
    var totalKindergartens = groups
        .Select(x => x.KindergartenName)
        .Where(x => !string.IsNullOrWhiteSpace(x))
        .Distinct()
        .Count();
}

<style>
    .kg-page {
        background: #f7f8fc;
        min-height: 80vh;
        padding: 32px;
        border-radius: 20px;
        color: #20243a;
    }

    .kg-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 30px;
    }

    .kg-title {
        font-size: 30px;
        font-weight: 750;
        letter-spacing: -1px;
        margin: 0;
    }

    .kg-subtitle {
        color: #858ba3;
        margin: 8px 0 0;
        font-size: 14px;
    }

    .kg-create {
        background: #6257e8;
        color: white;
        border: none;
        border-radius: 10px;
        padding: 12px 20px;
        font-weight: 600;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 9px;
        transition: .2s ease;
        white-space: nowrap;
    }

        .kg-create:hover {
            background: #5045d0;
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 6px 18px #6257e833;
        }

    .kg-stats {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 18px;
        margin-bottom: 28px;
    }

    .kg-stat {
        background: white;
        padding: 23px;
        border: 1px solid #eceef5;
        border-radius: 16px;
        display: flex;
        align-items: center;
        gap: 16px;
        box-shadow: 0 3px 12px #252a4410;
    }

    .kg-stat-icon {
        width: 48px;
        height: 48px;
        border-radius: 13px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 21px;
        flex-shrink: 0;
    }

    .kg-purple {
        background: #eeebff;
        color: #6257e8;
    }

    .kg-blue {
        background: #e5f2ff;
        color: #2671c9;
    }

    .kg-orange {
        background: #fff0df;
        color: #c27b27;
    }

    .kg-stat-label {
        color: #858ba3;
        font-size: 13px;
        margin-bottom: 5px;
    }

    .kg-stat-value {
        font-size: 25px;
        font-weight: 750;
        line-height: 1.2;
    }

    .kg-panel {
        background: white;
        border: 1px solid #eceef5;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 3px 12px #252a440a;
    }

    .kg-panel-header {
        padding: 22px 24px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        border-bottom: 1px solid #f0f1f6;
    }

    .kg-panel-title {
        font-size: 17px;
        font-weight: 700;
        margin: 0;
    }

    .kg-count {
        background: #eeebff;
        color: #6257d9;
        padding: 5px 11px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 700;
    }

    .kg-table-wrap {
        overflow-x: auto;
    }

    .kg-table {
        width: 100%;
        border-collapse: collapse;
        margin: 0;
        white-space: nowrap;
    }

        .kg-table thead th {
            background: #fafbfe;
            color: #858ba3;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .6px;
            padding: 16px 18px;
            border-bottom: 1px solid #eceef5;
        }

        .kg-table tbody td {
            padding: 17px 18px;
            border-bottom: 1px solid #f0f1f6;
            vertical-align: middle;
            font-size: 13px;
        }

        .kg-table tbody tr:last-child td {
            border-bottom: none;
        }

        .kg-table tbody tr {
            transition: background .15s ease;
        }

            .kg-table tbody tr:hover {
                background: #faf9ff;
            }

    .kg-number {
        color: #9a9fb2;
        font-weight: 600;
    }

    .kg-group {
        display: flex;
        align-items: center;
        gap: 11px;
        font-weight: 700;
        color: #292d45;
    }

    .kg-avatar {
        width: 36px;
        height: 36px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        background: #eeebff;
        color: #6257e8;
        font-weight: 800;
        font-size: 12px;
        flex-shrink: 0;
    }

    .kg-school {
        color: #555b74;
        font-weight: 500;
    }

    .kg-children {
        display: inline-block;
        background: #e8f7ef;
        color: #238653;
        padding: 6px 10px;
        border-radius: 8px;
        font-weight: 700;
    }

    .kg-teacher {
        color: #454b63;
    }

    .kg-date {
        color: #858ba3;
        font-size: 12px;
    }

    .kg-actions {
        display: flex;
        align-items: center;
        gap: 7px;
    }

    .kg-action {
        display: inline-flex;
        justify-content: center;
        align-items: center;
        gap: 5px;
        padding: 8px 11px;
        border-radius: 8px;
        font-size: 12px;
        font-weight: 650;
        text-decoration: none;
        border: 1px solid transparent;
        transition: .15s ease;
    }

    .kg-details {
        background: #eeebff;
        color: #6257d9;
    }

        .kg-details:hover {
            background: #ded9ff;
            color: #493ec3;
        }

    .kg-update {
        background: #e9f3ff;
        color: #2671c9;
    }

        .kg-update:hover {
            background: #d7e9ff;
            color: #1556a2;
        }

    .kg-delete {
        background: #fff0f0;
        color: #d44747;
    }

        .kg-delete:hover {
            background: #ffe0e0;
            color: #b92e2e;
        }

    .kg-empty {
        padding: 55px 20px;
        text-align: center;
    }

    .kg-empty-icon {
        width: 64px;
        height: 64px;
        margin: 0 auto 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 16px;
        background: #eeebff;
        color: #6257e8;
        font-size: 28px;
    }

    .kg-empty-title {
        font-size: 18px;
        font-weight: 750;
        margin-bottom: 7px;
    }

    .kg-empty-text {
        color: #858ba3;
        font-size: 14px;
        margin-bottom: 20px;
    }

    @@media (max-width: 768px) {
        .kg-page {
            padding: 18px;
        }

        .kg-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .kg-stats {
            grid-template-columns: 1fr;
            gap: 12px;
        }

        .kg-title {
            font-size: 25px;
        }

        .kg-panel-header {
            padding: 18px;
        }
    }
</style>

<div class="kg-page">

    <div class="kg-header">
        <div>
            <h1 class="kg-title">Kindergarten groups</h1>
            <p class="kg-subtitle">
                Manage kindergarten groups, children and teachers in one place.
            </p>
        </div>

        <a asp-controller="Kindergarten"
               asp-action="Create"
               class="kg-create">
            <i class="bi bi-plus-lg"></i>
            Add new group
        </a>
    </div>

    <div class="kg-stats">

        <div class="kg-stat">
            <div class="kg-stat-icon kg-purple">
                <i class="bi bi-collection"></i>
            </div>
            <div>
                <div class="kg-stat-label">Total groups</div>
                <div class="kg-stat-value">@totalGroups</div>
            </div>
        </div>

        <div class="kg-stat">
            <div class="kg-stat-icon kg-blue">
                <i class="bi bi-people"></i>
            </div>
            <div>
                <div class="kg-stat-label">Total children</div>
                <div class="kg-stat-value">@totalChildren</div>
            </div>
        </div>

        <div class="kg-stat">
            <div class="kg-stat-icon kg-orange">
                <i class="bi bi-building"></i>
            </div>
            <div>
                <div class="kg-stat-label">Kindergartens</div>
                <div class="kg-stat-value">@totalKindergartens</div>
            </div>
        </div>

    </div>

    <div class="kg-panel">

        <div class="kg-panel-header">
            <h2 class="kg-panel-title">All groups</h2>
            <span class="kg-count">@totalGroups groups</span>
        </div>

        @if (groups.Any())
        {
            <div class="kg-table-wrap">
                <table class="kg-table">
                    <thead>
                        <tr>
                            <th>Nr.</th>
                            <th>Group</th>
                            <th>Kindergarten</th>
                            <th>Children</th>
                            <th>Teacher</th>
                            <th>Created</th>
                            <th>Updated</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @{
                            var nr = 1;
                        }

                        @foreach (var item in groups)
                        {
                            <tr>
                                <td class="kg-number">@nr</td>

                                <td>
                                    <div class="kg-group">
                                        <div class="kg-avatar">
                                            @(string.IsNullOrWhiteSpace(item.GroupName)
                                                ? "KG"
                                                : item.GroupName.Length >= 2
                                                    ? item.GroupName.Substring(0, 2).ToUpper()
                                                    : item.GroupName.ToUpper())
                                        </div>
                                        <span>@item.GroupName</span>
                                    </div>
                                </td>

                                <td class="kg-school">
                                    @item.KindergartenName
                                </td>

                                <td>
                                    <span class="kg-children">
                                        @item.ChildrenCount
                                    </span>
                                </td>

                                <td class="kg-teacher">
                                    @item.TeacherName
                                </td>

                                <td class="kg-date">
                                    @item.CreatedAt.ToString("dd.MM.yyyy HH:mm:ss")
                                </td>

                                <td class="kg-date">
                                    @item.UpdatedAt.ToString("dd.MM.yyyy HH:mm:ss")
                                </td>

                                <td>
                                    <div class="kg-actions">
                                        <a asp-controller="Kindergarten"
                                               asp-action="Details"
                                               asp-route-id="@item.Id"
                                               class="kg-action kg-details">
                                            <i class="bi bi-eye"></i>
                                            View
                                        </a>

                                        <a asp-controller="Kindergarten"
                                               asp-action="Update"
                                               asp-route-id="@item.Id"
                                               class="kg-action kg-update">
                                            <i class="bi bi-pencil"></i>
                                            Edit
                                        </a>

                                        <a asp-controller="Kindergarten"
                                               asp-action="Delete"
                                               asp-route-id="@item.Id"
                                               class="kg-action kg-delete">
                                            <i class="bi bi-trash3"></i>
                                            Delete
                                        </a>
                                    </div>
                                </td>
                            </tr>

                            nr++;
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="kg-empty">
                <div class="kg-empty-icon">
                    <i class="bi bi-building"></i>
                </div>

                <div class="kg-empty-title">No groups yet</div>

                <p class="kg-empty-text">
                    Get started by creating your first kindergarten group.
                </p>

                <a asp-controller="Kindergarten"
                       asp-action="Create"
                       class="kg-create">
                    <i class="bi bi-plus-lg"></i>
                    Create first group
                </a>
            </div>
        }

    </div>
</div>
