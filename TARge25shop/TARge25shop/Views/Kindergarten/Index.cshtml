@model IEnumerable<TARge25shop.Models.Kindergarten.KindergartenIndexViewModel>

@{
    ViewData["Title"] = "Kindergarten";
}

<div >
    <a asp-controller="Kindergarten" asp-action="Create" class="btn btn-primary">
        Create
    </a>
</div>

<h1>Kindergarten</h1>

<table class="table">
    <thead>
        <tr>
            <th>Nr</th>
            <th>Group Name</th>
            <th>Kindergarten Name</th>
            <th>Children Count</th>
            <th>Teacher Name</th>
            <th>Created Date</th>
            <th>Updated Date</th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td></td>
                <td>@item.GroupName</td>
                <td>@item.KindergartenName</td>
                <td>@item.ChildrenCount</td>
                <td>@item.TeacherName</td>
                <td>@item.CreatedAt</td>
                <td>@item.UpdatedAt</td>

                <td>
                    <a asp-controller="Kindergarten"
                       asp-action="Details"
                       asp-route-id="@item.Id"
                       class="btn btn-primary">
                        Details
                    </a>
                    |
                    <a asp-controller="Kindergarten"
                       asp-action="Update"
                       asp-route-id="@item.Id"
                       class="btn btn-primary">
                        Edit
                    </a>
                    |
                    <a asp-controller="Kindergarten"
                       asp-action ="Delete"
                       asp-route-id="@item.Id" 
                       class="btn btn-danger">
                        
                            Delete
                       
                        
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>