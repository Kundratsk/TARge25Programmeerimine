@model TARge25shop.Models.Kindergarten.KindergartenDetailsViewModel

@{
    ViewData["Title"] = "Kindergarten Details";
}

<style>
    .kg-details-page {
        background: #f7f8fc;
        min-height: 80vh;
        padding: 32px;
        border-radius: 20px;
        color: #20243a;
    }

    .kg-details-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 28px;
    }

    .kg-details-title {
        font-size: 30px;
        font-weight: 750;
        letter-spacing: -1px;
        margin: 0;
    }

    .kg-details-subtitle {
        color: #858ba3;
        font-size: 14px;
        margin: 8px 0 0;
    }

    .kg-details-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
    }

    .kg-btn {
        display: inline-flex;
        justify-content: center;
        align-items: center;
        gap: 8px;
        padding: 11px 17px;
        border-radius: 10px;
        font-size: 13px;
        font-weight: 650;
        text-decoration: none;
        border: 1px solid transparent;
        transition: .2s ease;
    }

    .kg-btn-back {
        background: white;
        border-color: #e6e8f0;
        color: #555b74;
    }

        .kg-btn-back:hover {
            background: #f0f1f7;
            color: #292d45;
        }

    .kg-btn-edit {
        background: #6257e8;
        color: white;
    }

        .kg-btn-edit:hover {
            background: #5045d0;
            color: white;
            transform: translateY(-1px);
        }

    .kg-details-card {
        background: white;
        border: 1px solid #eceef5;
        border-radius: 16px;
        overflow: hidden;
        margin-bottom: 24px;
        box-shadow: 0 3px 12px #252a440a;
    }

    .kg-card-header {
        padding: 22px 24px;
        border-bottom: 1px solid #f0f1f6;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
    }

    .kg-card-title {
        font-size: 17px;
        font-weight: 700;
        margin: 0;
    }

    .kg-card-description {
        font-size: 13px;
        color: #858ba3;
        margin: 5px 0 0;
    }

    .kg-info-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0;
        padding: 8px 24px;
    }

    .kg-info-item {
        padding: 20px 12px;
        border-bottom: 1px solid #f0f1f6;
        min-width: 0;
    }

        .kg-info-item:nth-last-child(-n+2) {
            border-bottom: none;
        }

    .kg-info-label {
        color: #858ba3;
        font-size: 12px;
        font-weight: 600;
        margin-bottom: 9px;
    }

    .kg-info-value {
        color: #292d45;
        font-size: 15px;
        font-weight: 650;
        overflow-wrap: anywhere;
    }

    .kg-group-value {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .kg-group-avatar {
        width: 42px;
        height: 42px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #eeebff;
        color: #6257e8;
        font-size: 13px;
        font-weight: 800;
        flex-shrink: 0;
    }

    .kg-children-badge {
        display: inline-block;
        background: #e8f7ef;
        color: #238653;
        padding: 7px 12px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 700;
    }

    .kg-date-value {
        color: #555b74;
        font-size: 14px;
        font-weight: 500;
    }

    .kg-image-count {
        background: #eeebff;
        color: #6257d9;
        padding: 5px 11px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 700;
    }

    .kg-gallery {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
        gap: 18px;
        padding: 24px;
    }

    .kg-image-card {
        border: 1px solid #eceef5;
        border-radius: 12px;
        overflow: hidden;
        background: #fafbfe;
        transition: .2s ease;
    }

        .kg-image-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 22px #252a4412;
        }

    .kg-image-frame {
        height: 175px;
        background: #f0f1f7;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
    }

        .kg-image-frame img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }

    .kg-image-caption {
        padding: 12px 14px;
        color: #454b63;
        font-size: 13px;
        font-weight: 600;
        overflow-wrap: anywhere;
    }

    .kg-empty-images {
        padding: 42px 20px;
        text-align: center;
        color: #858ba3;
        font-size: 14px;
    }

        .kg-empty-images i {
            display: block;
            font-size: 28px;
            color: #a2a6b8;
            margin-bottom: 12px;
        }

    @@media (max-width: 768px) {
        .kg-details-page {
            padding: 18px;
        }

        .kg-details-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .kg-details-title {
            font-size: 25px;
        }

        .kg-info-grid {
            grid-template-columns: 1fr;
            padding: 8px 18px;
        }

        .kg-info-item:nth-last-child(-n+2) {
            border-bottom: 1px solid #f0f1f6;
        }

        .kg-info-item:last-child {
            border-bottom: none;
        }

        .kg-card-header {
            padding: 18px;
        }

        .kg-gallery {
            grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
            padding: 18px;
            gap: 12px;
        }

        .kg-image-frame {
            height: 145px;
        }
    }
</style>

<div class="kg-details-page">

    <div class="kg-details-header">
        <div>
            <h1 class="kg-details-title">Group details</h1>
            <p class="kg-details-subtitle">
                View kindergarten group information and uploaded images.
            </p>
        </div>

        <div class="kg-details-actions">
            <a asp-action="Index" class="kg-btn kg-btn-back">
                <i class="bi bi-arrow-left"></i>
                Back to groups
            </a>

            <a asp-action="Update"
                   asp-route-id="@Model.Id"
                   class="kg-btn kg-btn-edit">
                <i class="bi bi-pencil"></i>
                Edit group
            </a>
        </div>
    </div>

    <div class="kg-details-card">
        <div class="kg-card-header">
            <div>
                <h2 class="kg-card-title">General information</h2>
                <p class="kg-card-description">
                    Basic information about this group.
                </p>
            </div>
        </div>

        <div class="kg-info-grid">

            <div class="kg-info-item">
                <div class="kg-info-label">Group name</div>
                <div class="kg-info-value kg-group-value">
                    <div class="kg-group-avatar">
                        @(string.IsNullOrWhiteSpace(Model.GroupName)
                            ? "KG"
                            : Model.GroupName.Length >= 2
                                ? Model.GroupName.Substring(0, 2).ToUpper()
                                : Model.GroupName.ToUpper())
                    </div>
                    <span>@Model.GroupName</span>
                </div>
            </div>

            <div class="kg-info-item">
                <div class="kg-info-label">Kindergarten name</div>
                <div class="kg-info-value">
                    @Model.KindergartenName
                </div>
            </div>

            <div class="kg-info-item">
                <div class="kg-info-label">Children count</div>
                <div class="kg-info-value">
                    <span class="kg-children-badge">
                        @Model.ChildrenCount children
                    </span>
                </div>
            </div>

            <div class="kg-info-item">
                <div class="kg-info-label">Teacher name</div>
                <div class="kg-info-value">
                    @Model.TeacherName
                </div>
            </div>

            <div class="kg-info-item">
                <div class="kg-info-label">Created at</div>
                <div class="kg-info-value kg-date-value">
                    @Model.CreatedAt.ToString("dd.MM.yyyy HH:mm:ss")
                </div>
            </div>

            <div class="kg-info-item">
                <div class="kg-info-label">Last updated</div>
                <div class="kg-info-value kg-date-value">
                    @Model.UpdatedAt.ToString("dd.MM.yyyy HH:mm:ss")
                </div>
            </div>

        </div>
    </div>

    <div class="kg-details-card">
        <div class="kg-card-header">
            <div>
                <h2 class="kg-card-title">Images</h2>
                <p class="kg-card-description">
                    Images uploaded for this kindergarten group.
                </p>
            </div>

            <span class="kg-image-count">
                @(Model.Image?.Count ?? 0) images
            </span>
        </div>

        @if (Model.Image == null || Model.Image.Count == 0)
        {
            <div class="kg-empty-images">
                <i class="bi bi-image"></i>
                No images have been uploaded yet.
            </div>
        }
        else
        {
            <div class="kg-gallery">
                @foreach (var img in Model.Image)
                {
                    <div class="kg-image-card">
                        <div class="kg-image-frame">
                            <img src="@img.ImageData"
                                 alt="@img.ImageTitle"
                                 loading="lazy" />
                        </div>

                        <div class="kg-image-caption">
                            @(string.IsNullOrWhiteSpace(img.ImageTitle)
                                ? "Untitled image"
                                : img.ImageTitle)
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <div class="kg-details-actions">
        <a asp-action="Index" class="kg-btn kg-btn-back">
            <i class="bi bi-arrow-left"></i>
            Back to groups
        </a>

        <a asp-action="Update"
               asp-route-id="@Model.Id"
               class="kg-btn kg-btn-edit">
            <i class="bi bi-pencil"></i>
            Edit group
        </a>
    </div>

</div>
