@model TARge25shop.Models.Kindergarten.KindergartenDetailsViewModel

@{
    ViewData["Title"] = "Kindergarten Details";
}

<h1>Kindergarten Details</h1>

<div>
    <dl class="row">

        <dt class="col-sm-3">
            Group Name
        </dt>
        <dd class="col-sm-9">
            @Model.GroupName
        </dd>

        <dt class="col-sm-3">
            Kindergarten Name
        </dt>
        <dd class="col-sm-9">
            @Model.KindergartenName
        </dd>

        <dt class="col-sm-3">
            Children Count
        </dt>
        <dd class="col-sm-9">
            @Model.ChildrenCount
        </dd>

        <dt class="col-sm-3">
            Teacher Name
        </dt>
        <dd class="col-sm-9">
            @Model.TeacherName
        </dd>

        <dt class="col-sm-3">
            Created At
        </dt>
        <dd class="col-sm-9">
            @Model.CreatedAt
        </dd>

        <dt class="col-sm-3">
            Updated At
        </dt>
        <dd class="col-sm-9">
            @Model.UpdatedAt
        </dd>

        <dt class="col-sm-3">
            Images
        </dt>
        <dd class="col-sm-9">
            @if (Model.Image.Count == 0)
            {
                <span class="text-muted">No images</span>
            }
            else
            {
                <div class="d-flex flex-wrap gap-3">
                    @foreach (var img in Model.Image)
                    {
                        <img src="@img.ImageData"
                             alt="@img.ImageTitle"
                             style="height:150px; width:auto;"
                             class="img-thumbnail" />
                    }
                </div>
            }
        </dd>

    </dl>
</div>

<a asp-action="Update"
   asp-route-id="@Model.Id"
   class="btn btn-warning">
    Update
</a>

<a asp-action="Index"
   class="btn btn-secondary">
    Back
</a>