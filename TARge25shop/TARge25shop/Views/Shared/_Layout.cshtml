@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    var navItems = new[]
    {
        (Text: "Home",         Controller: "Home",         Action: "Index",   Icon: "bi-house-door"),
        (Text: "Privacy",      Controller: "Home",         Action: "Privacy", Icon: "bi-shield-lock"),
        (Text: "Spaceship",    Controller: "Spaceship",    Action: "Index",   Icon: "bi-rocket-takeoff"),
        (Text: "Kindergarten", Controller: "Kindergarten", Action: "Index",   Icon: "bi-emoji-smile"),
        (Text: "Real estate",  Controller: "Realestate",   Action: "Index",   Icon: "bi-buildings"),
        (Text: "Chuck Norris", Controller: "chucknorris",  Action: "Index",   Icon: "bi-lightning-charge"),
        (Text: "Cocktails",    Controller: "cocktail",     Action: "Index",   Icon: "bi-cup-straw"),
        (Text: "Weather",      Controller: "Weather",      Action: "Index",   Icon: "bi-cloud-sun")
    };
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TARge25shop</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TARge25shop.styles.css" asp-append-version="true" />
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
        /* ---------- Western navbar ---------- */
        .western-nav {
            background: linear-gradient(180deg, #1b1026 0%, #3a1a3d 60%, #7a3b1d 100%);
            border-bottom: 3px solid #f5c26b;
            box-shadow: 0 6px 20px rgba(0,0,0,.45);
        }
        .western-nav .navbar-brand {
            color: #f5c26b;
            font-family: Georgia, 'Times New Roman', serif;
            font-weight: 700;
            letter-spacing: .06em;
            text-shadow: 0 2px 4px #000;
        }
        .western-nav .navbar-brand:hover { color: #ffe3a3; }

        .app-link {
            position: relative;
            color: #f5e9d0 !important;
            font-weight: 600;
            border-radius: 8px;
            padding: .5rem .8rem !important;
            transition: background .2s, color .2s, box-shadow .2s, transform .2s;
            animation: link-drop .6s cubic-bezier(.34,1.56,.64,1) both;
        }
        .app-link i { color: #f5c26b; margin-right: .35rem; }
        .app-link:hover {
            background: rgba(245,194,107,.15);
            color: #f5c26b !important;
            box-shadow: 0 0 0 1px #f5c26b, 0 0 16px rgba(245,194,107,.5);
            transform: translateY(-2px);
        }
        .app-link.active {
            background: rgba(185,28,28,.35);
            color: #ffe3a3 !important;
            box-shadow: inset 0 -3px 0 #f5c26b;
        }
        .nav-item:nth-child(1) .app-link { animation-delay: .05s; }
        .nav-item:nth-child(2) .app-link { animation-delay: .12s; }
        .nav-item:nth-child(3) .app-link { animation-delay: .19s; }
        .nav-item:nth-child(4) .app-link { animation-delay: .26s; }
        .nav-item:nth-child(5) .app-link { animation-delay: .33s; }
        .nav-item:nth-child(6) .app-link { animation-delay: .40s; }
        .nav-item:nth-child(7) .app-link { animation-delay: .47s; }
        .nav-item:nth-child(8) .app-link { animation-delay: .54s; }

        @@keyframes link-drop {
            from { opacity: 0; transform: translateY(-30px) scale(.8); }
            to   { opacity: 1; transform: translateY(0) scale(1); }
        }

        /* ---------- Kauboi ---------- */
        #cowboy { width: 78px; height: 62px; margin-right: .5rem; overflow: visible; flex-shrink: 0; }
        #cb-arm {
            transform-box: view-box;
            transform-origin: 70px 62px;
            transition: transform .2s ease-out;
        }

        /* ---------- Efektid ---------- */
        #fx { position: fixed; inset: 0; pointer-events: none; z-index: 2000; overflow: hidden; }
        #fx > * { position: absolute; }

        .bullet-hole {
            position: absolute;
            width: 14px; height: 14px;
            border-radius: 50%;
            pointer-events: none;
            background: radial-gradient(circle, #000 0 35%, #6b4423 55%, transparent 72%);
        }

        @@keyframes screen-shake {
            0%,100% { transform: translate(0,0); }
            20% { transform: translate(-6px,3px); }
            40% { transform: translate(5px,-4px); }
            60% { transform: translate(-4px,-2px); }
            80% { transform: translate(3px,3px); }
        }
        body.shake { animation: screen-shake .35s ease-in-out; }

        @@media (max-width: 575.98px) { #cowboy { width: 56px; height: 44px; } }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark western-nav sticky-top mb-4">
            <div class="container-fluid">
                <svg id="cowboy" viewBox="0 0 120 96" aria-hidden="true">
                    <!-- torso -->
                    <path d="M30 96V64q0-10 14-14h26q14 4 14 14v32z" fill="#7a3b1d" />
                    <path d="M52 52l8 14 8-14v44H52z" fill="#4a2312" />
                    <!-- bandana -->
                    <path d="M48 46h24l-12 16z" fill="#dc2626" />
                    <!-- pea -->
                    <circle cx="60" cy="32" r="13" fill="#e0a77a" />
                    <!-- müts -->
                    <ellipse cx="60" cy="22" rx="34" ry="6" fill="#3b2314" />
                    <path d="M44 22q0-24 16-24t16 24z" fill="#4a2c18" />
                    <rect x="44" y="15" width="32" height="4" fill="#f5c26b" />
                    <!-- tulistav käsi + revolver -->
                    <g id="cb-arm">
                        <rect x="68" y="58" width="22" height="9" rx="4" fill="#7a3b1d" />
                        <circle cx="92" cy="62" r="5" fill="#e0a77a" />
                        <rect x="92" y="55" width="22" height="7" rx="2" fill="#9ca3af" />
                        <rect x="92" y="53" width="10" height="11" rx="3" fill="#6b7280" />
                        <path d="M89 62h8l-2 12h-7z" fill="#4a2c18" />
                        <circle id="cb-muzzle" cx="115" cy="58" r="1.5" fill="none" />
                    </g>
                    <circle id="cb-shoulder" cx="70" cy="62" r="1" fill="none" />
                </svg>

                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-star-fill"></i> TARge25shop
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse">
                    <ul class="navbar-nav ms-auto gap-lg-1">
                        @foreach (var item in navItems)
                        {
                            var isActive = string.Equals(currentController, item.Controller, StringComparison.OrdinalIgnoreCase)
                                           && string.Equals(currentAction, item.Action, StringComparison.OrdinalIgnoreCase);
                            <li class="nav-item">
                                <a class="nav-link app-link @(isActive ? "active" : "")"
                                   asp-area="" asp-controller="@item.Controller" asp-action="@item.Action">
                                    <i class="bi @item.Icon"></i>@item.Text
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - TARge25shop - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <div id="fx"></div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        // ---------- Kauboi tulistab navi-linke ----------
        (function () {
            const fx = document.getElementById('fx');
            const arm = document.getElementById('cb-arm');
            const muzzle = document.getElementById('cb-muzzle');
            const shoulder = document.getElementById('cb-shoulder');
            const links = document.querySelectorAll('.app-link');
            let busy = false;

            const sleep = ms => new Promise(r => setTimeout(r, ms));
            const rand = (a, b) => a + Math.random() * (b - a);
            const center = el => {
                const r = el.getBoundingClientRect();
                return { x: r.left + r.width / 2, y: r.top + r.height / 2 };
            };

            // Pööra käsi sihtmärgi poole
            function aim(el) {
                const s = center(shoulder), t = center(el);
                const angle = Math.atan2(t.y - s.y, t.x - s.x) * 180 / Math.PI;
                arm.style.transform = 'rotate(' + angle + 'deg)';
            }

            // Sähvatus + kuulijoon
            function shoot(el) {
                const m = center(muzzle), t = center(el);
                const dist = Math.hypot(t.x - m.x, t.y - m.y);
                const ang = Math.atan2(t.y - m.y, t.x - m.x) * 180 / Math.PI;

                const flash = document.createElement('div');
                flash.style.cssText = 'left:' + (m.x - 22) + 'px;top:' + (m.y - 22) + 'px;width:44px;height:44px;border-radius:50%;' +
                    'background:radial-gradient(circle,#fff,#ffd36b 35%,#ff7a18 60%,transparent 72%)';
                fx.appendChild(flash);
                flash.animate([{ opacity: 1, transform: 'scale(.4)' }, { opacity: 0, transform: 'scale(1.6)' }],
                    { duration: 200, easing: 'ease-out' }).onfinish = () => flash.remove();

                const line = document.createElement('div');
                line.style.cssText = 'left:' + m.x + 'px;top:' + (m.y - 1.5) + 'px;width:' + dist + 'px;height:3px;' +
                    'transform-origin:0 50%;transform:rotate(' + ang + 'deg);' +
                    'background:linear-gradient(90deg,rgba(255,255,255,0),#fff 60%,#ffd36b);box-shadow:0 0 10px #ffb347';
                fx.appendChild(line);
                line.animate([
                    { clipPath: 'inset(0 100% 0 0)', opacity: 1 },
                    { clipPath: 'inset(0 0 0 0)', opacity: 1, offset: .5 },
                    { clipPath: 'inset(0 0 0 0)', opacity: 0 }
                ], { duration: 220, easing: 'ease-out' }).onfinish = () => line.remove();
            }

            // Sädemed ja killud
            function burst(at, n, colors, spread) {
                for (let i = 0; i < n; i++) {
                    const p = document.createElement('div');
                    const s = rand(3, 8);
                    p.style.cssText = 'left:' + at.x + 'px;top:' + at.y + 'px;width:' + s + 'px;height:' + s + 'px;border-radius:' +
                        (Math.random() < .4 ? '50%' : '2px') + ';background:' + colors[i % colors.length];
                    fx.appendChild(p);
                    const a = rand(0, Math.PI * 2), d = rand(spread * .4, spread);
                    p.animate([
                        { transform: 'translate(0,0) rotate(0)', opacity: 1 },
                        { transform: 'translate(' + Math.cos(a) * d + 'px,' + (Math.sin(a) * d + 40) + 'px) rotate(' + rand(-540, 540) + 'deg)', opacity: 0 }
                    ], { duration: rand(450, 800), easing: 'cubic-bezier(.2,.7,.4,1)' }).onfinish = () => p.remove();
                }
            }

            // Kauboi sihib hiirega üle käidud linki
            links.forEach(link => {
                link.addEventListener('mouseenter', () => { if (!busy) aim(link); });

                link.addEventListener('click', async function (e) {
                    // Lase Ctrl/Shift/Cmd-klõpsul ja uue vahekaardi avamisel normaalselt töötada
                    if (e.ctrlKey || e.metaKey || e.shiftKey || e.button !== 0) return;
                    e.preventDefault();
                    if (busy) return;
                    busy = true;

                    aim(link);
                    await sleep(230);
                    shoot(link);
                    await sleep(150);

                    // Tabamus: kuuliauk, värin, sädemed
                    const hole = document.createElement('span');
                    hole.className = 'bullet-hole';
                    hole.style.left = 'calc(50% + ' + rand(-12, 12) + 'px - 7px)';
                    hole.style.top = 'calc(50% + ' + rand(-6, 6) + 'px - 7px)';
                    link.appendChild(hole);

                    const c = center(link);
                    burst(c, 14, ['#fff', '#ffd36b', '#ff7a18'], 70);
                    document.body.classList.add('shake');
                    setTimeout(() => document.body.classList.remove('shake'), 380);
                    link.animate([{ transform: 'scale(1)' }, { transform: 'scale(1.18) rotate(-4deg)' }, { transform: 'scale(1)' }],
                        { duration: 300 });

                    await sleep(550);               // viivitus enne lehe vahetust
                    window.location.href = link.href;
                });
            });

            // Kui kasutaja tuleb "tagasi" nupuga, lähtesta olek
            window.addEventListener('pageshow', () => { busy = false; });
        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>