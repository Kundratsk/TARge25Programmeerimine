@model TARge25shop.Models.Account.ForgotPasswordViewModel


<div class="card shadow-sm p-4">
    <form action="ForgotPassword" asp-controller="Account" method="post">
<h3>Forgot your password</h3>
<p>Please enter the email address you'd like your password
    reset information sent to
</p>
        <div class="col-md-3">
            <label asp-for="Email">Enter email address:</label>
            <input asp-for="Email" placeholder="enter your email"/>
            <span asp-validation-for="Email"></span>
        </div>
        <div class="col-md-4">
            <button type="submit"´class="btn-success">Request reset link</button>
            <button asp-controller="home" type="submit" class="btn-danger">Back to login</button>
        </div>
</form>
</div>